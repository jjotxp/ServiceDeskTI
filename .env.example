PORT=3333
APP_NAME=ServiceDesk TI
ADMIN_EMAIL=ti@suaempresa.com
DATA_DIR=./data
ALLOWED_REQUESTER_EMAILS=usuario1@suaempresa.com,usuario2@suaempresa.com

# EMAIL_MODE=log registra as mensagens no terminal e em data/email-outbox.log.
# EMAIL_MODE=smtp tenta enviar por SMTP usando as configuracoes abaixo.
EMAIL_MODE=log
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario@suaempresa.com
SMTP_PASS=sua-senha-ou-app-password
SMTP_FROM="ServiceDesk TI <usuario@suaempresa.com>"
